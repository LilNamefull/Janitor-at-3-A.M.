--- !u!114 &2455963406240476536
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7705949446672827167}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 67d1209b8a5607f47ae93622f47c9c71, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueLines:
  - 'Chad.: How the hell did you find me?!

'
  - "Janitor.: Well you're not exactly hiding well. Also, hate to break it to you,
    but you\u2019re already dead.\n"
  - "Chad.: Yeah, no shit! Doesn\u2019t change the fact that I can\u2019t leave this
    damn building. And that bastard of a principal is still hunting me down\u2014even
    though I\u2019m dead!\n"
  - 'Janitor.: Look, we need to get to the point, I talked to Billy. He said you
    have a piece of that scroll you took from the principal. I need it if I want
    any chance of getting out of here.

'
  - "Chad..: Oh, you need it? Cool. Just one problem dipshit, I don\u2019t have it.
    Tried grabbing it from my own corpse, and guess what? Burned the hell outta my
    hand. That shit isn't exactly ghost friendly.\n"
  - 'Janitor.: Fine, then where''s your body?

'
  - 'Chad..: And what do I get from telling you that?

'
  - 'Janitor.: I could try to free your spirit from this school.

'
  - 'Chad...: You better keep your word, janitor, or else... *expands through the
    locker walls*

'
  - 'Janitor.: I will...I will... calm down.

'
  - 'Chad..: Aight, big boy. The last thing I remember is sprinting to the main exit
    but the damn door was locked. So I headed back into room Algebra 2 to hide out
    in. After that... I dunno - I think that was it, I guess.'
  spawnPrefab1: {fileID: 8064226487575135456, guid: 3f29889a2237d0a44a5e6e10a309f784, type: 3}
  spawnPoint1: {fileID: 2940976257540777822, guid: 07e923fe2ab3d4641903b8cafeeb59c4, type: 3}
  spawnPrefab2: {fileID: 8812681518849270898, guid: eee5ba5f3c8b5cd4d979b7ad155aa173, type: 3}
  spawnPoint2: {fileID: 8515862654527590853, guid: 6493413a19dae4a4eab2822c0b28f237, type: 3}
  interactDistance: 4
  taskIDsToAdd:
  - GetTheScroll1
  taskTitlesToAdd:
  - Get the half of the contract
  taskSubtitlesToAdd:
  - It schould be in Algebra 2
  taskIDsToRemove:
  - SpeakChad
